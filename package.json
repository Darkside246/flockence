{
  "name": "flockence",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ci:build": "npm test && prisma validate && prisma generate && npm run typecheck && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "test": "node --test tests/*.test.mjs",
    "migrate:vision-media": "node scripts/migrate-public-vision-media.mjs",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "hls.js": "^1.7.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "typescript": "6.0.3"
  }
}
