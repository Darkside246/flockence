DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chicken_op?schema=public"
FARM_ID="default-farm"
OPENAI_API_KEY=""
VISION_MODEL="gpt-5.6-luna"
# Persistent private image storage path. Must be outside the public web root and backed by a durable volume.
VISION_STORAGE_DIR=""

# Authentication / security
APP_URL="https://your-domain.example"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_COOKIE_SECURE="true"
CHICKEN_OP_USER_ID=""
# Required in production for initial owner setup and later staff invitations. Keep both secrets private.
FARM_OWNER_SETUP_CODE=""

# Password reset email via Resend (optional for local development, required for production reset emails)
RESEND_API_KEY=""
RESEND_FROM="Flockence <no-reply@your-domain.example>"

# For a remote PostgreSQL server, use an SSL connection, for example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chicken_op?schema=public&sslmode=require"

# WeatherAPI.com
WEATHER_API_KEY=""
WEATHER_CACHE_MINUTES="60"

# Oriya server-to-server integration. Legacy AURA variable names are retained for API compatibility.
AURA_INTEGRATION_TOKEN=""
AURA_QUOTE_SECRET=""

# Blink camera sidecar (services/blink). Loopback only; token must match the sidecar BLINK_SIDECAR_TOKEN.
BLINK_SIDECAR_URL="http://127.0.0.1:8765"
BLINK_SIDECAR_TOKEN=""
# curl_cffi profile used by the Blink sidecar (default Safari/iOS profile).
BLINK_IMPERSONATE="safari18_0_ios"
# Optional comma-separated DNS servers for the Python sidecar's curl_cffi session.
# Set this in the sidecar process environment, not only in Next.js .env.local.
BLINK_DNS_SERVERS=""

# Oriya is the brain (docs/ORIYA_LINK.md). From Oriya: Farm settings > Chicken Op link (key and secret shown once).
ORIYA_URL="https://oriya.si"
ORIYA_LINK_KEY_ID=""
ORIYA_LINK_SECRET=""
# Cameras Oriya may see, as code=Blink camera name, comma separated. Oriya only ever sees the code.
ORIYA_CAMERAS=""
ORIYA_HOUSE="Main"
# Long random token for the scheduled push (scripts/oriya-push.mjs); at least 24 characters.
ORIYA_PUSH_TOKEN=""
FLOCKENCE_LOCAL_URL="http://127.0.0.1:3000"

# Camera security (docs/CAMERA_SECURITY.md)
# Roles that may view cameras (READ_ONLY is left out by default).
CAMERA_VIEW_ROLES="OWNER,MANAGER,WORKER"
# Camera requests per person per minute (one live stream uses about 60).
CAMERA_REQUESTS_PER_MINUTE="600"
# 32 random bytes, base64: encrypts the saved Blink login. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BLINK_CREDENTIALS_KEY=""
# Extra networks the sidecar may answer (default: this machine only). Leave empty unless the app runs in a container.
BLINK_SIDECAR_ALLOWED_CLIENTS=""
